<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Third-party licenses (Rust)</title>
<style>
  body { font-family: sans-serif; margin: 16px; }
  pre { white-space: pre-wrap; font-size: 12px; background: #f4f4f4; padding: 8px; }
  @media (prefers-color-scheme: dark) { body { background: #111; color: #ddd; } pre { background: #222; } a { color: #8cf; } }
</style>
</head>
<body>
<h1>Third-party licenses (Rust)</h1>
<p>Crates compiled into libhwbp_core.so.</p>
<ul>
{{#each overview}}  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<ul>
{{#each used_by}}  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
